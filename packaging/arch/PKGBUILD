# Adapted from AUR hermes-agent 0.22.2 by Youcef/Evert;
# system-tools.py and interpreter patch from jabla/hermes-agent-bin.
pkgname=hermes-agent
_commit=4d04303818b61bf3aa09278af48356315515965b
_commit_date=1792599405
pkgver=0.22.4
pkgrel=4
pkgdesc="Locally-run AI agent with tool use, web browsing, and automation"
arch=('x86_64')
url="https://github.com/VKKKV/hermes-agent"
license=('MIT')
install=$pkgname.install
depends=(
    'python>=3.14'
    'nodejs>=22.22'
    'npm'
    'uv'
    'ripgrep'
    'ffmpeg'
    'agent-browser'
)
optdepends=(
    'chromium: local browser automation (or google-chrome)'
    'google-chrome: local browser automation (or chromium)'
)
makedepends=('cmake' 'git')
options=('!strip' '!debug')
source=(
    "${pkgname}::git+https://github.com/NousResearch/hermes-agent.git#commit=${_commit}"
    'keep-venv-interpreter.patch'
    'system-tools.py'
    'posix-log-rotation.patch'
    'runtime-repairs.patch'
    'stable-backports.patch'
    'no-telemetry.patch'
    'no-telemetry-surfaces.patch'
    'no-telemetry-files.txt'
    'new-session-model.patch'
)
sha256sums=('SKIP'
            '516bee4492e4d6f6e4310703bdec7e88229a1b0ddb828542f297d4e6e226c427'
            '5950d73a49526767dfac20084d8c5597b7ebf5c16e7bff99e31dc4d7fe0d139d'
            '7bc4008a4562517f2da3341394dc9781f52a920f2b9968f9b8a3ba184b25e0a1'
            'bd3c6949e6adbddc673d19f538e1dd61f0f7e5e553ecfd4c9723e2414eec6762'
            'f8cf19256d16ebfb271208a71342cfdef7ca629f40e629987da98b4eac4d83e2'
            'c0a89026b49727d7879b20ee24ab9643888ef90386ba0e4cf5eab7d68d513977'
            'd96e57d3f649988567faa117b320830120ae633c9bd017bf13f046e166649228'
            '71329cf35ec75c686819f0875d81dc68c409acc943bd6275648cea1c9ff34a06'
            'a9d824f93b910a1f44b76045609441acdc9e9ba87448e2887cd66b65608b13ea')

prepare() {
  cd "${pkgname}"

  patch --batch --fuzz=0 -Np1 -i "${srcdir}/keep-venv-interpreter.patch"
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/posix-log-rotation.patch"
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/runtime-repairs.patch"
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/stable-backports.patch"
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/no-telemetry.patch"
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/no-telemetry-surfaces.patch"
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/new-session-model.patch"
  while IFS= read -r _path; do
    [[ "$_path" != /* && "$_path" != *..* && "$_path" != .git/* && -f "$_path" && ! -L "$_path" ]] || return 1
  done < "${srcdir}/no-telemetry-files.txt"
  while IFS= read -r _path; do
    rm -- "$_path" || return 1
  done < "${srcdir}/no-telemetry-files.txt"
}

build() {
  cd "${pkgname}"

  [ ! -d .git ] && mkdir .git

  npm ci --ignore-scripts --no-fund --no-audit --progress=false --include=dev
  npm run build --workspace web
  npm run build:ink --workspace ui-tui
  npm run build --workspace ui-tui

  UV_PYTHON_DOWNLOADS=never uv venv \
    --python /usr/bin/python3 \
    --relocatable \
    venv

  CMAKE_POLICY_VERSION_MINIMUM=3.5 \
  UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT="$PWD/venv" \
    uv sync --frozen --no-dev --no-install-project \
      --extra all \
      --extra messaging \
      --extra anthropic \
      --extra exa \
      --extra edge-tts \
      --extra ddgs \
      --extra doc-extract \
      --extra feishu \
      --extra matrix \
      --extra dingtalk \
      --extra wecom \
      --extra teams \
      --extra google-chat
}

check() {
  cd "${pkgname}"
  export HERMES_HOME="${srcdir}/check-home"
  export HERMES_DISABLE_LAZY_INSTALLS=1
  export PYTHONDONTWRITEBYTECODE=1
  mkdir -p "$HERMES_HOME"

  test -s hermes_cli/web_dist/index.html
  test -s ui-tui/dist/entry.js
  PYTHONPATH="$PWD" venv/bin/python -c \
    'import hermes_cli.main, anthropic, exa_py, edge_tts, ddgs, lark_oapi, mautrix, defusedxml'
}

package() {
  cd "${pkgname}"

  _optdir="$pkgdir/opt/$pkgname"
  install -d "$_optdir"

  bsdtar -C . -cf - \
    --exclude='__pycache__' --exclude='.git' \
    --exclude='node_modules' --exclude='web/src' \
    --exclude='web/package.json' --exclude='web/package-lock.json' \
    --exclude='web/vite.config.ts' --exclude='web/tsconfig*.json' \
    --exclude='web/eslint.config.js' --exclude='web/README.md' \
    --exclude='ui-tui/src' --exclude='ui-tui/node_modules' \
    --exclude='scripts/tests' --exclude='scripts/install.*' \
    --exclude='tests' --exclude='build' --exclude='packaging' \
    . | bsdtar -C "$_optdir" -xf -

  echo "console.log('skipping build, using prebuilt dist/entry.js')" > "$_optdir/ui-tui/scripts/build.mjs"

  _tuidir="$_optdir/hermes_cli/tui_dist"
  install -d "$_tuidir"
  if [ -d "ui-tui/dist" ]; then
    cp -a ui-tui/dist/* "$_tuidir/"
  fi
  chmod -R a+rX "$_optdir/ui-tui/dist" "$_tuidir" 2>/dev/null || true
  rm -f "$_optdir/venv/.lock"

  _built_at="$(date -u -d "@${SOURCE_DATE_EPOCH:-$(date +%s)}" '+%Y-%m-%dT%H:%M:%SZ')"
  _runtime_dir="/opt/$pkgname/system-store/tools"
  cat > "$_optdir/install-stamp.json" <<EOF
{
  "schemaVersion": 2,
  "commit": "${_commit}",
  "commitDate": ${_commit_date},
  "branch": "release/v0.22.4",
  "builtAt": "${_built_at}",
  "dirty": false,
  "source": "github-upstream",
  "distribution": "package-manager",
  "updateMechanism": "external",
  "runtimeDir": "${_runtime_dir}",
  "baseVersion": "${pkgver}",
  "displayVersion": "${pkgver}+kita.privacy",
  "localPatches": ["posix-log-rotation", "runtime-repairs", "stable-backports", "no-telemetry", "new-session-model"],
  "distance": 0,
  "payload": "bootstrap",
  "tag": null
}
EOF

  printf '%s\n' pacman > "$_optdir/.install_method"
  venv/bin/python -B "${srcdir}/system-tools.py" "$_optdir" "$_optdir/system-store/tools"

  install -d "$_optdir/venv/lib/python3.14/site-packages"
  {
      echo "import sys; sys.path.insert(0, \"/opt/$pkgname\")"
  } > "$_optdir/venv/lib/python3.14/site-packages/hermes.pth"

  install -d "$pkgdir/usr/bin"
  {
    echo '#!/bin/bash'
    echo 'unset PYTHONPATH'
    echo 'unset PYTHONHOME'
    echo ': "${XDG_DATA_HOME:=$HOME/.local/share}"'
    echo 'export HERMES_DISABLE_LAZY_INSTALLS=1'
    echo 'export HERMES_LAZY_INSTALL_TARGET="$XDG_DATA_HOME/hermes-agent/python"'
    echo ': "${HERMES_NODE:=/usr/bin/node}"'
    echo 'export HERMES_NODE'
    echo 'if [[ -z "${AGENT_BROWSER_EXECUTABLE_PATH:-}" ]]; then'
    echo '  for browser in google-chrome-stable google-chrome chromium; do'
    echo '    if browser_path="$(type -P "${browser}")"; then'
    echo '      export AGENT_BROWSER_EXECUTABLE_PATH="${browser_path}"'
    echo '      break'
    echo '    fi'
    echo '  done'
    echo 'fi'
    echo 'if [[ -z "${AGENT_BROWSER_EXECUTABLE_PATH:-}" ]]; then'
    echo '  printf "%s\n" "hermes: No Chrome/Chromium on PATH. Install chromium or google-chrome, or set AGENT_BROWSER_EXECUTABLE_PATH. Browser downloads are disabled." >&2'
    echo 'fi'
    echo "exec /opt/$pkgname/venv/bin/python -I -m hermes_cli.main" '"$@"'
  } > "$pkgdir/usr/bin/hermes"

  chmod 755 "$pkgdir/usr/bin/hermes"
  chmod -R a+rX "$_optdir/system-store" "$_optdir/hermes_cli/_launchers.py"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
